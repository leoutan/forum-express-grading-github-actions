{{!-- navbar --}}
<ul class="nav nav-pills">
  <li class="nav-item">
    <a class="nav-link {{#ifCond '' categoryId}}active{{/ifCond}}" aria-current="page"
      href="/restaurants?categoryId=">全部</a>
  </li>
  {{#each categories}}
  <li class="nav-item">
    <a class="nav-link {{#ifCond this.id ../categoryId}}active{{/ifCond}}" aria-current="page" href="/restaurants?categoryId={{this.id}}">{{this.name}}</a>
  </li>
  {{/each}}
</ul>
{{!-- restaurants list --}}
<div class="row mt-3">
  {{#each restaurants}}
  <div class="col-md-4">
    <div class="card mb-4 shadow-sm">
      <a href="/restaurants/{{this.id}}" >
        <img class="card-img-top img-fluid" src="{{this.image}}" alt="Card image cap" width="100%" height="180px"
          style="transition: opacity 0.5s; opacity:0; width: 100%; height: 180px; " onload="this.style.opacity=1;">
      </a>
      <div class="card-body">
        <p class="card-text">
          <a href="/restaurants/{{this.id}}">
            {{this.name}}
          </a>
        </p>
        <span class="badge bg-secondary">{{this.Category.name}}</span>
        <p class="card-text text-truncate">{{this.description}}</p>
      </div>
    </div>
  </div>
  {{/each}}
</div>

{{!-- paginator --}}
<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class="page-item">
      <a class="page-link" href="?categoryId={{categoryId}}&page={{pagination.prev}}" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
    {{#each pagination.pages}}
    {{#ifCond this ../pagination.currentPage}}
    <li class="page-item active">
      <a class="page-link" href="#">
        {{this}}
      </a>
    </li>
    {{else}}
    <li class="page-item {{#ifCond this ../pagination.currentPage}}active{{/ifCond}}">
      <a class="page-link" href="?categoryId={{../categoryId}}&page={{this}}">
        {{this}}
      </a>
    </li>
    {{/ifCond}}
    {{/each}}
    <li class="page-item">
      <a class="page-link" href="?categoryId={{categoryId}}&page={{pagination.next}}" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>