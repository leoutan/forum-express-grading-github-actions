{{> admin-tabs route ='users'}}
<br />
<br />
<table class="table align-middle">
  <thead class="thead-dark">
    <tr>
      <th scope="col">#</th>
      <th scope="col">Name</th>
      <th scope="col">Email</th>
      <th scope="col">Role</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <th scope="row">{{this.id}}</th>
      <td>{{this.name}}</td>
      <td>{{this.email}}</td>
      <td>{{this.isAdmin}}</td>
      <td>
        <form action="/admin/users/{{this.id}}?_method=PATCH" method="post">
          {{#if this.isAdmin}}
          <button type="submit" class="btn btn-link" onclick="javascript: return confirm('確定變更 {{this.name}} 身分嗎?')">set as user</button>
          {{else}}
          <button type="submit" class="btn btn-link" onclick="javascript: return confirm('確定變更 {{this.name}} 身分嗎?')">set as admin</button>
          {{/if}}
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>