<div class="row">
  <div class="col-md-4">
    <img src="{{user.image}}" class="img-thumbnail" alt="...">
  </div>
  <div class="col-md-8">
    <h1>{{user.name}}</h1>
    <ul>
      <li><strong>email: </strong>{{user.email}}</li>
      <li><strong>isAdmin: </strong>{{#ifCond user.isAdmin 1}}True{{else}}False{{/ifCond}}</li>
    </ul>
    {{#ifCond user.id user.id}}
      {{!-- user 在 app.js 中已經透過 helper 取得登入的使用者並放到 res.locals 中 --}}
    <a href="/users/{{user.id}}/edit" class="btn btn-primary">edit</a>
    {{/ifCond}}
    <a href="javascript: history.back()" class="btn btn-warning">back</a>
  </div>
</div>

<div class="row mt-2">
  <div class="card">
    <h3 class="card-title">
      已評論的餐廳
    </h3>
    <div class="card-body">
      <div class="d-flex">
        {{#each user.Comments}}
        <a href="/restaurants/{{this.Restaurant.id}}" class="mx-1">
          <img src="{{this.Restaurant.image}}" alt="" style="width: 100px; height:100px">
        </a>
        {{/each}}
      </div>
    </div>
  </div>
</div>
